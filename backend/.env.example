# ============================================================
# Real-Time Emotion-Aware Voice Assistant - Environment Config
# ============================================================
# Copy this file to ".env" and fill in values as needed.
# The application runs fully WITHOUT any of these set
# (rule-based chat + HuggingFace emotion model + Web Speech API).
# Set OPENAI_API_KEY only if you want richer LLM responses.

# ---- Server ----
APP_HOST=0.0.0.0
APP_PORT=8000
APP_NAME="Emotion-Aware Voice Assistant"
# Comma-separated list of allowed origins for CORS.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000,file://

# ---- Database ----
DATABASE_URL=sqlite:///./assistant.db

# ---- Emotion detection ----
# HuggingFace model that classifies English text into 7 emotions:
# anger, disgust, fear, joy, neutral, sadness, surprise.
EMOTION_MODEL=j-hartmann/emotion-english-distilroberta-base
# Lazy-load the model on first request (faster startup).
EMOTION_LAZY_LOAD=true
# Fallback to a lightweight keyword model if transformers is missing.
EMOTION_FALLBACK_ENABLED=true

# ---- Conversation / LLM ----
# "rule" uses the built-in emotion-aware rule engine (default, no API).
# "openai" uses OpenAI Chat Completions (requires OPENAI_API_KEY).
# "auto" uses openai if a key is set, otherwise rule.
CHAT_ENGINE=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo

# ---- Logging ----
LOG_LEVEL=INFO
